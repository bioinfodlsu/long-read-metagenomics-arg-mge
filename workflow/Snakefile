# Extract full reads for plasmid
rule extract_full_reads_plasmid:
    input:
        samples = lambda wc: f"samples/{wc.sample}.fasta" if wc.sample in FASTA_SAMPLES else f"converted/{wc.sample}.fasta",
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta"
    output:
        "results/plasmid_extracted/{sample}_plasmid.fasta"
    log: "logs/plasmid_extracted/{sample}.log"
    threads: THREADS_10
    conda: "envs/seqkit.yaml"
    shell:
        '''
        seqkit grep -f <(grep "^>" {input.extracted_samples} \
            | sed 's/>//' \
            | awk '{{print $1}}' \
            | sed 's/_part[0-9]*//' \
            | sort -u) \
            {input.samples} > {output} 2> {log}
        '''

# Alignment for plasmid
rule align_plasmid:
    input: 
        plasmid_extracted = "results/plasmid_extracted/{sample}_plasmid.fasta",
    conda: "envs/LAST.yaml"
    threads: THREADS_100
    params:
        db = "database/last/db/plasmid-db"
    log: "logs/align_plasmid/{sample}.log"
    output: "results/maf/{sample}_plasmid.maf"
    shell: "lastal -m10 -D1e6 -K1 -P{threads} {params.db} {input.plasmid_extracted} > {output} 2> {log}"

# Kraken Classification of reads

rule classify_kraken:
    input:
        plasmid_extracted = "results/plasmid_extracted/{sample}_plasmid.fasta",
        db = ancient("database/kraken2/gtdb_kraken2")
    conda: "envs/kraken2.yaml"
    log: "logs/kraken/{sample}.log"
    threads: THREADS_100
    output:
        tab = "results/kraken/{sample}_taxonomy.tab",
        report = "results/kraken/{sample}_taxonomy.txt"
    threads: 20
    shell:
        "k2 classify --use-names --memory-mapping --threads {threads} --db {input.db} {input.plasmid_extracted} --output {output.tab} --report {output.report} > {log} 2>&1"
# TO DO: ADD RULES FOR BRACKEN
rule build_bracken_db:
    input: 
        db = ancient("database/kraken2/gtdb_kraken2")
    params:
        kmer = 26
    threads: THREADS_100
    conda: "envs/bracken.yaml"
    output: 
        distrib = "database/kraken2/gtdb_kraken2/database{avg_len}mers.kmer_distrib"
    shell:
        "bracken-build -d {input.db} -k {params.kmer} -t {threads} -l {wildcards.avg_len}"

rule bracken_classify_genus:
    input:
        kraken_report = "results/kraken/{sample}_taxonomy.txt",
        db = ancient("database/kraken2/gtdb_kraken2")
    params:
        avg_len = lambda wildcards: avg_lengths[wildcards.sample]
    threads: THREADS_100
    conda: "envs/bracken.yaml"
    log: "logs/bracken_genus/{sample}.log"
    output: "results/kraken/{sample}_genus.bracken"
    shell:
        "bracken -d {input.db} -i {input.kraken_report} -o {output} -r {params.avg_len} -l G -t {threads} > {log} 2>&1"

# Parsing Scripts

# IS
rule process_is:
    input: 
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta",
        alignment = "results/maf/{sample}_IS.maf",
        metadata = ancient("metadata/ISFinder_metadata.txt"),
        arg_summary = "results/arg_summary/{sample}_CARD_summary.csv",
        fasta_headers = "results/arg_headers/{sample}_ARG.txt"
    conda: "envs/process.yaml"
    threads: THREADS_80
    log: "logs/is_processing/{sample}.log"
    output: 
        summary = "results/is_summary/{sample}_IS_summary.csv",
        merged = "results/arg_is_merged/{sample}_ARG_IS_summary.csv"
    shell: "python scripts/IS_parse.py --input {input.alignment} --fasta_headers {input.fasta_headers} --IS_metadata {input.metadata} --arg {input.arg_summary} --output {output.summary} --merged_output {output.merged} > {log} 2>&1"

# TN_INT
rule process_tn_int:
    input: 
        tn3_alignment = "results/maf/{sample}_Tn3.maf",
        tn554_alignment = "results/maf/{sample}_Tn554.maf",
        tn7_alignment = "results/maf/{sample}_Tn7.maf",
        integron_alignment = "results/maf/{sample}_integron.maf",
        fasta_headers = "results/arg_headers/{sample}_ARG.txt",
        integrase_headers = ancient("metadata/integrase_headers.txt"),
        arg_is = "results/arg_is_merged/{sample}_ARG_IS_summary.csv",
    conda: "envs/process.yaml"
    threads: THREADS_80
    log: "logs/tn_int_processing/{sample}.log"
    output: 
        summary = "results/all_summary/{sample}_all_summary.csv",
    shell:
        """
        if [ -s {input.tn3_alignment} ]; then
            TN3="--input_tn3 {input.tn3_alignment}"
        else
            TN3=""
            echo "WARNING: Tn3 maf is empty, skipping" >> {log}
        fi

        if [ -s {input.tn7_alignment} ]; then
            TN7="--input_tn7 {input.tn7_alignment}"
        else
            TN7=""
            echo "WARNING: Tn7 maf is empty, skipping" >> {log}
        fi

        if [ -s {input.tn554_alignment} ]; then
            TN554="--input_tn554 {input.tn554_alignment}"
        else
            TN554=""
            echo "WARNING: Tn554 maf is empty, skipping" >> {log}
        fi

        if [ -s {input.integron_alignment} ]; then
            INTEGRON="--input_integron {input.integron_alignment}"
        else
            INTEGRON=""
            echo "WARNING: Integron maf is empty, skipping" >> {log}
        fi

        python scripts/tn_in_parse.py \
            $TN3 $TN7 $TN554 \
            $INTEGRON \
            --fasta_headers {input.fasta_headers} \
            --integrase_headers {input.integrase_headers} \
            --arg_is {input.arg_is} \
            --output {output.summary} >> {log} 2>&1
        """

# PLASMID_TAXO
rule process_plasmid_taxo:
    input:
        plasmid_alignment = "results/maf/{sample}_plasmid.maf",
        kraken_report = "results/kraken/{sample}_taxonomy.txt",
        kraken_reads = "results/kraken/{sample}_taxonomy.tab",
        typing = ancient("metadata/typing.csv"),
        finder = ancient("metadata/plasmidfinder.csv"),
        all_summary = "results/all_summary/{sample}_all_summary.csv",
    conda: "envs/process.yaml"
    threads: THREADS_100
    log: "logs/plasmid_taxo_processing/{sample}.log"
    output:
        summary = "results/final_summary/{sample}_final_summary.csv"
    shell: "python scripts/plasmid_taxo_parse.py --plasmid {input.plasmid_alignment} --tax-report {input.kraken_report} --tax-reads {input.kraken_reads} --typing {input.typing} --finder {input.finder} --summary {input.all_summary} --output {output.summary} > {log} 2>&1"
