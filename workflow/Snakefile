import pandas as pd
avg_lengths = pd.read_csv("metadata/avg_read_length.csv", index_col=0).squeeze("columns")
UNIQUE_LENGTHS = avg_lengths.unique().tolist()

(FASTQ_SAMPLES,) = glob_wildcards("samples/{sample}.fastq")
(FASTA_SAMPLES,) = glob_wildcards("samples/{sample}.fasta")
ALL_SAMPLES = list(set(FASTQ_SAMPLES + FASTA_SAMPLES))

CORES = workflow.cores if workflow.cores else 1

THREADS_10 = max(1, int(CORES * 0.1))
THREADS_20 = max(1, int(CORES * 0.2))
THREADS_50  = max(1, int(CORES * 0.5))
THREADS_80  = max(1, int(CORES * 0.8))
THREADS_100 = max(1, CORES)


rule all:
    input:
        "database/last/db/CARD-db.prj",
        "database/last/db/IS-db.prj",
        "database/last/db/Tn3-db.prj",
        "database/last/db/Tn7-db.prj",
        "database/last/db/Tn554-db.prj",
        "database/last/db/integron-db.prj",
        "database/last/db/plasmid-db.prj",
        expand("results/last/train/{sample}_CARD.train", sample=ALL_SAMPLES),
        expand("results/last/train/{sample}_IS.train", sample=ALL_SAMPLES),
        expand("results/last/train/{sample}_Tn3.train", sample=ALL_SAMPLES),
        expand("results/last/train/{sample}_Tn7.train", sample=ALL_SAMPLES),
        expand("results/last/train/{sample}_Tn554.train", sample=ALL_SAMPLES),
        expand("results/last/train/{sample}_integron.train", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_CARD.maf", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_IS.maf", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_Tn3.maf", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_Tn7.maf", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_Tn554.maf", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_integron.maf", sample=ALL_SAMPLES),
        expand("results/arg_summary/{sample}_CARD_summary.csv", sample=ALL_SAMPLES),
        expand("results/arg_extracted/{sample}_CARD_last.fasta", sample=ALL_SAMPLES),
        expand("results/arg_headers/{sample}_ARG.txt", sample=ALL_SAMPLES),
        expand("results/plasmid_extracted/{sample}_plasmid.fasta", sample=ALL_SAMPLES),
        expand("results/maf/{sample}_plasmid.maf", sample=ALL_SAMPLES),
        expand("results/kraken/{sample}_taxonomy.tab", sample=ALL_SAMPLES),
        expand("results/kraken/{sample}_taxonomy.txt", sample=ALL_SAMPLES),
        expand("database/kraken2/gtdb_kraken2/database{avg_len}mers.kmer_distrib", avg_len=UNIQUE_LENGTHS),
        expand("results/kraken/{sample}_genus.bracken", sample=ALL_SAMPLES),
        expand("results/is_summary/{sample}_IS_summary.csv", sample=ALL_SAMPLES),
        expand("results/arg_is_merged/{sample}_ARG_IS_summary.csv", sample=ALL_SAMPLES),
        expand("results/all_summary/{sample}_all_summary.csv", sample=ALL_SAMPLES),
        expand("results/final_summary/{sample}_final_summary.csv", sample=ALL_SAMPLES)


rule fastq_to_fasta:
    input: "samples/{sample}.fastq"
    conda: "envs/seqtk.yaml"
    output: "converted/{sample}.fasta"
    threads: THREADS_10
    shell: "seqtk seq -a {input} > {output}"

# Build DBs for LAST
rule build_arg_db:
    input: "database/card_protein_homolog_model.fasta"
    conda: "envs/LAST.yaml"
    output: "database/last/db/CARD-db.prj"
    threads: THREADS_50
    shell: "lastdb -q -c database/last/db/CARD-db {input}"

rule build_is_db:
    input: "database/ISFinder.fasta"
    conda: "envs/LAST.yaml"
    output: "database/last/db/IS-db.prj"
    threads: THREADS_50
    shell: "lastdb -q -c database/last/db/IS-db {input}"

