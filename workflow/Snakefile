    input: "database/plasmid.fasta"
    conda: "envs/LAST.yaml"
    output: "database/last/db/plasmid-db.prj"
    threads: THREADS_50
    shell: "lastdb -c database/last/db/plasmid-db {input}"

# TRAIN STEP FOR ARG
rule train_arg:
    input:
        samples = lambda wc: f"samples/{wc.sample}.fasta" if wc.sample in FASTA_SAMPLES else f"converted/{wc.sample}.fasta",
    conda: "envs/LAST.yaml"
    log: "logs/train_arg/{sample}.log"
    output: "results/last/train/{sample}_CARD.train"
    params:
        db = "database/last/db/CARD-db"
    threads: THREADS_50
    shell: "last-train -P{threads} --codon {params.db} {input.samples} > {output} 2> {log}"
# ALIGN STEP FOR ARG
rule align_arg:
    input:
        samples = lambda wc: f"samples/{wc.sample}.fasta" if wc.sample in FASTA_SAMPLES else f"converted/{wc.sample}.fasta",
        train = "results/last/train/{sample}_CARD.train"
    conda: "envs/LAST.yaml"
    log: "logs/align_arg/{sample}.log"
    params:
        db = "database/last/db/CARD-db"
    threads: THREADS_100
    output: "results/maf/{sample}_CARD.maf"
    shell: "lastal -p {input.train} -m10 -D1e6 -K1 -P{threads} {params.db} {input.samples} > {output} 2> {log}"

rule process_arg:
    input: 
        samples = lambda wc: f"samples/{wc.sample}.fasta" if wc.sample in FASTA_SAMPLES else f"converted/{wc.sample}.fasta",
        alignment = "results/maf/{sample}_CARD.maf",
        metadata = ancient("metadata/aro_index.tsv")
    conda: "envs/process.yaml"
    threads: THREADS_100
    resources:
        mem_mb = 60000
    log: "logs/arg_processing/{sample}.log"
    output: 
        summary = "results/arg_summary/{sample}_CARD_summary.csv",
        extracted = "results/arg_extracted/{sample}_CARD_last.fasta"
    shell: "python scripts/ARG_optimized_parse.py --input {input.samples} --maf {input.alignment} --metadata {input.metadata} --summary {output.summary} --output {output.extracted} > {log} 2>&1" 

# EXTRACT HEADERS FROM ARG FASTA FILE
rule extract_arg_headers:
    input: "results/arg_extracted/{sample}_CARD_last.fasta"
    output: "results/arg_headers/{sample}_ARG.txt"
    conda: "envs/process.yaml"
    threads: 1
    shell: "grep '^>' {input} | sed 's/^>//' > {output}"


# TRAIN and ALIGN STEP FOR IS
rule train_is:
    input:
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta",
    conda: "envs/LAST.yaml"
    log: "logs/train_is/{sample}.log"
    params:
        db = "database/last/db/IS-db"
    threads: THREADS_50
    output: "results/last/train/{sample}_IS.train"
    shell: "last-train -P{threads} --codon {params.db} {input.extracted_samples} > {output} 2> {log}"

rule align_is:
    input: 
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta",
        train = "results/last/train/{sample}_IS.train"
    conda: "envs/LAST.yaml"
    log: "logs/align_is/{sample}.log"
    params:
        db = "database/last/db/IS-db"
    threads: THREADS_20
    output: "results/maf/{sample}_IS.maf"
    shell: "lastal -p {input.train} -m10 -D1e6 -K1 -P{threads} {params.db} {input.extracted_samples} > {output} 2> {log}"

# TRAIN and ALIGN STEP FOR Tn3
rule train_tn3:
    input:
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta",
    conda: "envs/LAST.yaml"
    threads: THREADS_20
    log: "logs/train_tn3/{sample}.log"
    params:
        db = "database/last/db/Tn3-db"
    output: "results/last/train/{sample}_Tn3.train"
    shell: 
        """
        if [ -s {input.extracted_samples} ]; then
            last-train -P{threads} --codon {params.db} {input.extracted_samples} > {output} 2> {log} || touch {output}
        else
            touch {output}
        fi
        """

rule align_tn3:
    input: 
        extracted_samples = "results/arg_extracted/{sample}_CARD_last.fasta",
        train = "results/last/train/{sample}_Tn3.train"
    conda: "envs/LAST.yaml"
    threads: THREADS_20
    log: "logs/align_tn3/{sample}.log"
    params:
        db = "database/last/db/Tn3-db"
    output: "results/maf/{sample}_Tn3.maf"
    shell: 
        """
        if [ -s {input.train} ]; then
            lastal -p {input.train} -m10 -D1e6 -K1 -P{threads} {params.db} {input.extracted_samples} > {output} 2> {log} || touch {output}
        else
            touch {output}
        fi
        """

